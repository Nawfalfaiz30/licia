# Licia V31 — environment template
# DO NOT commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server-side only)
OPENAI_API_KEY=

# Public origin / server origin
NEXT_PUBLIC_SITE_URL=https://licia.example.com
APP_URL=https://licia.example.com
LICIA_INTERNAL_URL=http://127.0.0.1:3000
DEV_TUNNEL_ORIGIN=
# Hanya untuk pengembangan lokal; pisahkan beberapa origin dengan koma.
LICIA_DEV_ORIGINS=http://localhost:3000

# Web Push (generate with: npm run setup:push)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Reminder worker authentication
LICIA_CRON_SECRET=
LICIA_REMINDER_WORKER_INTERVAL_MS=60000

# AI models (optional overrides)
LICIA_AI_MODEL=gpt-4o-mini
LICIA_AI_HEAVY_MODEL=gpt-4o-mini

# Sync / reliability
LICIA_SYNC_RETENTION_DAYS=90
LICIA_SYNC_MAX_BATCH=500
LICIA_SYNC_DEFAULT_INTERVAL_SECONDS=15

# V32 Sync / Performance
LICIA_SYNC_CONFLICT_RETENTION_DAYS=90
LICIA_SYNC_MAX_BATCH=200
LICIA_CONTEXT_CACHE_TTL_MS=2500
LICIA_ENABLE_PROACTIVE_ASSISTANT=true
LICIA_PWA_CACHE_VERSION=licia-v32-pwa-r3
