# ============ Wajib ============
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# APP_URL=

# ============ AI ============
LICIA_AI_MODEL=gpt-6-luna
LICIA_AI_HEAVY_MODEL=
LICIA_AI_TOOL_MODEL=
# Model cadangan bila model utama error/overload (opsional)
LICIA_AI_FALLBACK_MODEL=
# Omit explicit temperature by default for compatibility with reasoning models.
LICIA_AI_OMIT_TEMPERATURE=true
# none|minimal|low|medium|high; leave empty to omit.
LICIA_AI_REASONING_EFFORT=none
# Kuota harian token AI per pengguna (0 = tanpa batas)
LICIA_AI_DAILY_TOKEN_LIMIT=0
# Streaming SSE di /api/chat (true/false)
LICIA_CHAT_STREAM=true

# ============ Web Push (npm run setup:push untuk membuat kunci) ============
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ============ Reminder worker / cron ============
LICIA_CRON_SECRET=
LICIA_REMINDER_WORKER_INTERVAL_MS=60000
LICIA_REMINDER_MAX_DELIVERY_ATTEMPTS=5
# Default: 24 jam setelah jadwal.
LICIA_REMINDER_MAX_OVERDUE_MS=86400000

# ============ Keamanan ============
# Hanya untuk klien non-browser di production.
LICIA_ALLOW_MISSING_ORIGIN=false

# ============ Opsional / pengembangan ============
LICIA_URL=http://localhost:3000
LICIA_INTERNAL_URL=
LICIA_CONTEXT_CACHE_TTL_MS=
LICIA_SYNC_CONFLICT_RETENTION_DAYS=30
LICIA_DEV_ORIGINS=
DEV_TUNNEL_ORIGIN=
